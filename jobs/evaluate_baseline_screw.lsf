#!/bin/bash
#BSUB -J baseline_reproduction_Eval_Screw
#BSUB -q hpc
#BSUB -n 4
#BSUB -R "span[hosts=1]"
#BSUB -R "rusage[mem=16GB]"
#BSUB -W 02:00
#BSUB -o logs/evaluate_baseline_screw_%J.out
#BSUB -e logs/evaluate_baseline_screw_%J.err

set -euo pipefail

cd "$HOME/msc-visual-anomaly-detection"

module load python3/3.11.13
source "$HOME/.venvs/vad-py311/bin/activate"
BASELINE_REPRODUCTION_DIR=$(python scripts/result_paths.py baseline_reproduction)

echo "=== baseline_reproduction SCREW CPU EVALUATION ==="
echo "Job ID: ${LSB_JOBID:-unknown}"
echo "Host: $(hostname)"
echo "Python: $(python --version)"
echo "Git commit: $(git rev-parse HEAD)"

if [ -e "$BASELINE_REPRODUCTION_DIR/screw_1shot_seed0/evaluation_metrics.json" ]; then
    echo "ERROR: Screw evaluation already completed."
    exit 1
fi

if [ -e /work3/s183356/exp003_eval_workspaces/screw_1shot_seed0 ]; then
    echo "ERROR: Screw evaluation workspace already exists."
    exit 1
fi

python -u scripts/evaluate_baseline_category.py \
    --category screw \
    --seed 0

echo "=== baseline_reproduction SCREW CPU EVALUATION COMPLETED ==="
