#!/bin/bash
#BSUB -J official_bottle_pilot_Eval
#BSUB -q hpc
#BSUB -n 1
#BSUB -R "span[hosts=1]"
#BSUB -R "rusage[mem=32GB]"
#BSUB -W 02:00
#BSUB -o logs/evaluate_official_bottle_%J.out
#BSUB -e logs/evaluate_official_bottle_%J.err

set -euo pipefail

cd "$HOME/msc-visual-anomaly-detection"

module load python3/3.11.13
source "$HOME/.venvs/vad-py311/bin/activate"
OFFICIAL_BOTTLE_PILOT_DIR=$(python scripts/result_paths.py official_bottle_pilot)

echo "=== official_bottle_pilot CPU EVALUATION ==="
echo "Job ID: ${LSB_JOBID:-unknown}"
echo "Host: $(hostname)"
echo "Python: $(python --version)"

RESULTS="${OFFICIAL_BOTTLE_PILOT_DIR}/official_bottle_1shot_seed0"

if [ ! -f "$RESULTS/metrics.json" ]; then
    echo "ERROR: official_bottle_pilot inference has not completed."
    exit 1
fi

if [ -e "$RESULTS/evaluation_metrics.json" ]; then
    echo "ERROR: Evaluation results already exist."
    exit 1
fi

python -u scripts/evaluate_official_bottle.py

echo "=== official_bottle_pilot CPU EVALUATION COMPLETED ==="
