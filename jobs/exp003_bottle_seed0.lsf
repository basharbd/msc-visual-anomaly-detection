#!/bin/bash
#BSUB -J EXP003_Bottle_S0
#BSUB -q gpua100
#BSUB -n 4
#BSUB -R "span[hosts=1]"
#BSUB -R "rusage[mem=4GB]"
#BSUB -gpu "num=1:mode=exclusive_process"
#BSUB -W 01:00
#BSUB -o logs/exp003_bottle_seed0_%J.out
#BSUB -e logs/exp003_bottle_seed0_%J.err

set -euo pipefail

cd "$HOME/msc-visual-anomaly-detection"

module load python3/3.11.13
source "$HOME/.venvs/vad-py311/bin/activate"

echo "=== EXP-003 CONTROLLED GPU PILOT ==="
echo "Job ID: ${LSB_JOBID:-unknown}"
echo "Host: $(hostname)"
echo "Python: $(python --version)"
echo "Git commit: $(git rev-parse HEAD)"

nvidia-smi

if [ -e results/EXP-003/bottle_1shot_seed0 ]; then
    echo "ERROR: EXP-003 pilot output already exists."
    exit 1
fi

python -u scripts/exp003_full_baseline.py \
    --category bottle \
    --seed 0

echo "=== EXP-003 GPU PILOT COMPLETED ==="
